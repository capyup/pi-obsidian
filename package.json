{
  "name": "pi-obsidian",
  "version": "0.1.0",
  "description": "pi extension that wraps the Obsidian CLI as typed tools — read, list, search, outline, create, append, open, backlinks, tags, daily-append.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "obsidian",
    "vault",
    "notes",
    "markdown"
  ],
  "files": [
    "extensions/**/*",
    "README.md",
    "LICENSE",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typebox": "^1.1.24",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lulucatdev/pi-obsidian.git"
  },
  "pi": {
    "extensions": [
      "./extensions/obsidian/index.ts"
    ]
  }
}
